from django.shortcuts import render, get_object_or_404, redirect
from django.contrib.auth.decorators import login_required
from django.contrib.auth.models import User
from .models import Carpeta, Profile
from documentos.models import Correspondencia, PQRSF, TipoDocumento
from django.contrib import messages

@login_required
def ventanilla_unica(request):
    user_p = request.user.profile
    dep = user_p.dependencia
    is_master = request.user.is_superuser or user_p.rol == 'SUPER' or dep == 'VENTANILLA'

    if is_master:
        # CORREOS
        correos_pendientes = Correspondencia.objects.filter(estado='PENDIENTE')
        correos_direccionados = Correspondencia.objects.exclude(estado='PENDIENTE')
        # PQRSF
        pqrsf_pendientes = PQRSF.objects.filter(estado='NUEVO')
        pqrsf_direccionadas = PQRSF.objects.exclude(estado='NUEVO')
    else:
        # Los asesores solo ven lo que ya les fue direccionado a su oficina
        correos_pendientes = Correspondencia.objects.none() # No ven pendientes globales
        correos_direccionados = Correspondencia.objects.filter(oficina_destino=dep)
        pqrsf_pendientes = PQRSF.objects.none()
        pqrsf_direccionadas = PQRSF.objects.filter(oficina_destino=dep)
    
    return render(request, 'ventanilla/bandeja.html', {
        'correos_p': correos_pendientes,
        'correos_d': correos_direccionados,
        'pqrsf_p': pqrsf_pendientes,
        'pqrsf_d': pqrsf_direccionadas,
        'is_master': is_master
    })

